<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
 <name>MOD_VENECIA_SLIDER</name><author>Slider</author><version>1.0.1</version><description>MOD_VENECIA_SLIDER_DESC</description>
 <namespace path="src">Joomla\Module\VeneciaSlider</namespace>
 <files><folder module="mod_venecia_slider">services</folder><folder>src</folder><folder>tmpl</folder><folder>language</folder></files>
 <media destination="mod_venecia_slider" folder="media"><filename>slider.css</filename><filename>botanical-corner.svg</filename><filename>slider.js</filename></media>
 <languages folder="language"><language tag="ru-RU">ru-RU/mod_venecia_slider.ini</language><language tag="ru-RU">ru-RU/mod_venecia_slider.sys.ini</language><language tag="en-GB">en-GB/mod_venecia_slider.ini</language><language tag="en-GB">en-GB/mod_venecia_slider.sys.ini</language></languages>
 <config><fields name="params"><fieldset name="basic">
 <field name="autoplay" type="radio" label="MOD_VENECIA_SLIDER_AUTOPLAY" default="1" class="btn-group btn-group-yesno"><option value="0">JNO</option><option value="1">JYES</option></field>
 <field name="interval" type="number" label="MOD_VENECIA_SLIDER_INTERVAL" default="8" min="2" filter="integer" showon="autoplay:1"/>
 <field name="slides" type="subform" label="MOD_VENECIA_SLIDER_SLIDES" formsource="/modules/mod_venecia_slider/src/Subform/slides.xml" multiple="true" layout="joomla.form.field.subform.repeatable" buttons="add,remove,move"/>
 </fieldset><fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL"/><field name="moduleclass_sfx" type="text" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"/><field name="cache" type="list" label="COM_MODULES_FIELD_CACHING_LABEL" default="1"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="900" label="COM_MODULES_FIELD_CACHE_TIME_LABEL"/><field name="cachemode" type="hidden" default="static"/></fieldset></fields></config>
 <updateservers><server type="extension" priority="1" name="Venecia Slider">https://raw.githubusercontent.com/shivayanamahom/mod-venecia-slider/main/updates.xml</server></updateservers>
</extension>
